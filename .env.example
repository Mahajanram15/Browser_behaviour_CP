# ==============================================================================
# BROWSER-TO-BACKEND BEHAVIORAL INTEGRITY VERIFICATION SYSTEM
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/behavioral_integrity_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/behavioral_integrity_db

# Machine Learning Artifact Paths
MODEL_PATH=ml/models/xgboost_behavior.json
FASTTEXT_MODEL_PATH=ml/models/fasttext_api.bin
FAISS_INDEX_PATH=ml/models/faiss_endpoints.index
MARKOV_MODEL_PATH=ml/models/markov_transitions.pkl

# Behavioral Risk Thresholds
RISK_THRESHOLD_ALLOW=0.35
RISK_THRESHOLD_CHALLENGE=0.70
# Scores >= 0.70 trigger Rate Limit / Block action

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SDK_BATCH_INTERVAL_MS=2000
